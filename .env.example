# ============================================================
# HorizonEcole — LeSouverain : template de configuration VPS
# Copier en .env et remplir les valeurs réelles
# ============================================================

NODE_ENV=production
PORT=4002

# PostgreSQL local (créé sur le VPS)
DATABASE_URL=postgresql://lesouverain:MOT_DE_PASSE@localhost:5432/lesouverain_db

# JWT — générer avec : openssl rand -base64 64
JWT_SECRET=REMPLACER_PAR_UN_SECRET_FORT
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=https://lesouverain-larabia.com
FRONTEND_URL=https://lesouverain-larabia.com

# SMTP (Hostinger ou autre)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=HorizonEcole

# Fuseau horaire de l'école
SCHOOL_TIMEZONE=Africa/Abidjan
