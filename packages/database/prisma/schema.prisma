  INSTALLMENTS
}

// Paramètres de rémunération par enseignant
model teacher_remuneration {
  id                  String           @id @default(uuid())
  teacher_id          String           @unique
  mode_remuneration   RemunerationMode
  taux_horaire        Decimal?         @db.Decimal(10, 2) // Si HORAIRE
  heures_hebdo        Int? // Si HORAIRE
  forfait_mensuel     Decimal?         @db.Decimal(10, 2) // Si FORFAIT_MENSUEL
  periode_facturation String           @default("MENSUELLE") @db.VarChar(50)
  cnps_applicable     Boolean          @default(true)
  compte_bancaire     String?          @db.VarChar(255)
  mode_paiement       String?          @db.VarChar(50)
  created_at          DateTime         @default(now())
  updated_at          DateTime         @default(now()) @updatedAt
  teacher             teachers         @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@map("teacher_remuneration")
}

// Primes et indemnités
model teacher_allowances {
  id             String            @id @default(uuid())
  teacher_id     String
  title          String            @db.VarChar(200)
  amount         Decimal           @db.Decimal(10, 2)
  type_montant   AllowanceType
  is_recurring   Boolean           @default(false)
  is_taxable     Boolean           @default(true)
  category       AllowanceCategory
  effective_from DateTime          @db.Date
  effective_to   DateTime?         @db.Date
  notes          String?           @db.Text
  condition      String?           @db.Text
  created_at     DateTime          @default(now())
  updated_at     DateTime          @default(now()) @updatedAt
  teacher        teachers          @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@index([teacher_id])
  @@index([is_recurring])
  @@index([effective_from, effective_to])
  @@map("teacher_allowances")
}

// Paramètres globaux de paie
model payroll_settings {
  id                       String            @id @default(uuid())
  date_calcul_mensuel      Int               @default(25) // Jour du mois pour génération auto
  nombre_semaines_par_mois Decimal           @default(4.33) @db.Decimal(4, 2)
  seniority_rule_type      SeniorityRuleType @default(MONTANT_PAR_PALIER)
  seniority_rule_value     Decimal?          @db.Decimal(5, 2) // % par année ou montant (pour ancien système)
  seniority_rule_max       Decimal?          @db.Decimal(5, 2) // % max ou null (pour ancien système)
  seniority_bareme         Json?             // Barème par paliers: [{minYears: 0, maxYears: 2, percentage: 0}, ...]
  
  // Prorata configuration
  prorata_enabled          Boolean           @default(true)
  prorata_basis            ProrataBasis      @default(CALENDAR_DAYS)
  prorata_days_in_month_method DaysInMonthMethod @default(ACTUAL)
  prorata_rounding         RoundingRule      @default(ROUND_NEAREST)
  prorata_include_primes   Boolean           @default(true)
  prorata_apply_to         Json?             // Liste des éléments affectés: ["base_salary","housing","transport",...]
  
  // Acomptes configuration
  acompte_enabled          Boolean           @default(true)
  acompte_max_pct_per_month Decimal?        @db.Decimal(5, 2) // % max du salaire brut (ex: 40%)
  acompte_max_amount_per_request Decimal?  @db.Decimal(10, 2) // Plafond absolu par demande (FCFA)
  acompte_max_requests_per_month Int?       @default(2) // Nombre max de demandes par mois
  acompte_requires_admin_approval Boolean   @default(true)
  acompte_auto_apply_to_payroll Boolean      @default(true)
  acompte_allow_multiple_types Boolean       @default(true)
  acompte_rounding         RoundingRule?     @default(ROUND_NEAREST)
  acompte_repayment_method RepaymentMethod?  @default(SINGLE_MONTH)
  acompte_plafond_percent  Decimal?          @db.Decimal(5, 2) // Ancien champ, conservé pour compatibilité
  
  assiette_imposable       String            @default("BRUT_MOINS_COTISATIONS") @db.VarChar(100)
  calcul_igr_actif         Boolean           @default(false)
  calcul_cnps_actif        Boolean           @default(true)
  taux_cnps_salarie        Decimal?          @db.Decimal(5, 2)
  taux_cnps_employeur      Decimal?          @db.Decimal(5, 2)
  bareme_imposition        Json?             // Tableau de tranches IGR
  created_at               DateTime          @default(now())
  updated_at               DateTime          @default(now()) @updatedAt

  @@map("payroll_settings")
}

// Heures effectuées par les vacataires (par mois)
model teacher_hours {
  id           String   @id @default(uuid())
  teacher_id  String
  month        Int
  year         Int
  hours_worked Decimal  @db.Decimal(5, 2)
  subject      String?  @db.VarChar(200)
  notes        String?  @db.Text
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt
  teacher      teachers @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@unique([teacher_id, month, year])
  @@index([teacher_id])
  @@index([month, year])
  @@map("teacher_hours")
}

// Absences des enseignants
model teacher_absences {
  id              String   @id @default(uuid())
  teacher_id      String
  date            DateTime @db.Date
  hours_absent    Decimal  @db.Decimal(5, 2) // Nombre d'heures d'absence (ex: 2, 4, 8)
  is_justified    Boolean  @default(false) // Absence justifiée ou non
  reason          String?  @db.VarChar(200) // Motif de l'absence
  notes           String?  @db.Text // Notes supplémentaires
  created_by      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt
  teacher         teachers @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("AbsenceCreator", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([teacher_id])
  @@index([date])
  @@index([teacher_id, date])
  @@map("teacher_absences")
}

// Paies mensuelles
model monthly_payrolls {
  id                  String                        @id @default(uuid())
  teacher_id          String
  month               Int
  year                Int
  status              PayrollStatus                 @default(DRAFT)
  base_salary         Decimal                       @db.Decimal(10, 2)
  total_allowances    Decimal                       @default(0) @db.Decimal(10, 2)
  seniority_bonus     Decimal                       @default(0) @db.Decimal(10, 2)
  total_brut          Decimal                       @db.Decimal(10, 2)
  deductions          Decimal                       @default(0) @db.Decimal(10, 2)
  net_payable         Decimal                       @db.Decimal(10, 2)
  hours_worked        Decimal?                      @db.Decimal(5, 2) // Pour horaire
  absences_deduction  Decimal                       @default(0) @db.Decimal(10, 2)
  advances_deduction  Decimal                       @default(0) @db.Decimal(10, 2)
  prorata_amount      Decimal?                      @db.Decimal(10, 2) // Montant du prorata
  prorata_days        Int?                          // Jours travaillés
  prorata_total_days  Int?                          // Jours totaux du mois
  cnps_salarie        Decimal?                      @db.Decimal(10, 2)
  cnps_employeur      Decimal?                      @db.Decimal(10, 2)
  igr                 Decimal?                      @db.Decimal(10, 2)
  validated_by        String?
  validated_at        DateTime?
  created_by          String?
  created_at          DateTime                      @default(now())
  updated_at          DateTime                      @default(now()) @updatedAt
  teacher             teachers                      @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  validatedBy         User?                         @relation("PayrollValidator", fields: [validated_by], references: [id], onDelete: SetNull)
  createdBy           User?                         @relation("PayrollCreator", fields: [created_by], references: [id], onDelete: SetNull)
  items               payroll_items[]
  payments            payroll_payments[]
  correction_requests payroll_correction_requests[]

  @@unique([teacher_id, month, year])
  @@index([teacher_id])
  @@index([month, year])
  @@index([status])
  @@map("monthly_payrolls")
}

// Lignes de détail de paie
model payroll_items {
  id              String           @id @default(uuid())
  payroll_id      String
  item_type       String           @db.VarChar(50) // BASE, ALLOWANCE, SENIORITY, DEDUCTION, ABSENCE, ADVANCE
  item_label      String           @db.VarChar(200)
  amount          Decimal          @db.Decimal(10, 2)
  allowance_id    String? // Si c'est une prime/indemnité
  is_taxable      Boolean          @default(true)
  notes           String?          @db.Text
  created_at      DateTime         @default(now())
  monthly_payroll monthly_payrolls @relation(fields: [payroll_id], references: [id], onDelete: Cascade)

  @@index([payroll_id])
  @@index([item_type])
  @@map("payroll_items")
}

// Paiements effectués
model payroll_payments {
  id              String           @id @default(uuid())
  payroll_id      String
  amount          Decimal          @db.Decimal(10, 2)
  payment_date    DateTime         @db.Date
  payment_method  PaymentMethod
  reference       String?          @db.VarChar(100)
  notes           String?          @db.Text
  created_by      String?
  created_at      DateTime         @default(now())
  monthly_payroll monthly_payrolls @relation(fields: [payroll_id], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("PayrollPaymentCreator", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([payroll_id])
  @@index([payment_date])
  @@map("payroll_payments")
}

// Acomptes versés
model advance_payments {
  id                     String        @id @default(uuid())
  teacher_id             String
  amount                 Decimal       @db.Decimal(10, 2)
  payment_date           DateTime      @db.Date
  payment_method         PaymentMethod
  reference              String?       @db.VarChar(100)
  notes                  String?       @db.Text
  status                 String        @default("PENDING") @db.VarChar(50) // PENDING, APPROVED, REJECTED
  approved_by            String?
  approved_at            DateTime?
  repayment_method       RepaymentMethod @default(SINGLE_MONTH)
  installments_count    Int?          @default(1) // Nombre d'échéances si installments
  deducted               Boolean       @default(false) // Si déjà déduit d'une paie
  deducted_in_payroll_id String? // ID de la paie où déduit
  created_by             String?
  created_at             DateTime      @default(now())
  updated_at             DateTime      @default(now()) @updatedAt
  teacher                teachers      @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  createdBy              User?         @relation("AdvancePaymentCreator", fields: [created_by], references: [id], onDelete: SetNull)
  approvedBy             User?         @relation("AdvancePaymentApprover", fields: [approved_by], references: [id], onDelete: SetNull)

  @@index([teacher_id])
  @@index([payment_date])
  @@index([deducted])
  @@index([status])
  @@map("advance_payments")
}

// Demandes de correction de paie (enseignant → admin)
model payroll_correction_requests {
  id              String           @id @default(uuid())
  payroll_id      String
  teacher_id      String
  reason          String           @db.Text
  status          String           @default("PENDING") @db.VarChar(50) // PENDING, APPROVED, REJECTED
  response        String?          @db.Text
  responded_by    String?
  responded_at    DateTime?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @default(now()) @updatedAt
  monthly_payroll monthly_payrolls @relation(fields: [payroll_id], references: [id], onDelete: Cascade)
  respondedBy     User?            @relation("PayrollCorrectionResponder", fields: [responded_by], references: [id], onDelete: SetNull)

  @@index([payroll_id])
  @@index([teacher_id])
  @@index([status])
  @@map("payroll_correction_requests")
}
