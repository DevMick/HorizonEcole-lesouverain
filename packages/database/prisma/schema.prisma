model student_absences {
  id               String   @id @default(uuid())
  academic_year_id String
  student_id       String
  class_id         String
  semester_id      String
  subject_id       String
  teacher_id       String
  hours_absent     Decimal  @db.Decimal(3, 1) // Nombre d'heures d'absence (peut être 0.5, 1, 1.5, 2, etc.)
  date             DateTime @db.Date
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  academicYear AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [student_id], references: [id], onDelete: Cascade)
  class        SchoolClass  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  semester     semesters    @relation(fields: [semester_id], references: [id], onDelete: Cascade)
  subject      subjects     @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  teacher      teachers     @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@index([academic_year_id])
  @@index([student_id])
  @@index([class_id])
  @@index([semester_id])
  @@index([subject_id])
  @@index([teacher_id])
  @@index([date])
  @@index([academic_year_id, teacher_id, subject_id, date])
  @@map("student_absences")
}

// ============================================
// CONDUITE (note de comportement)
// ============================================

// Paramètres du calcul de la conduite, par année scolaire.
// base_note = note de départ (16/20) ; hours_per_point = nombre d'heures de cours
// manquées qui coûte 1 point (2) ; period_minutes = durée d'un créneau de l'emploi
// du temps (50 min = 1 heure de cours) ; default_session_hours = heures retenues
// pour une séance sans horaire ; coefficient = poids dans la moyenne générale.
model conduct_settings {
  id                    String   @id @default(uuid())
  academic_year_id      String   @unique
  base_note             Decimal  @default(20) @db.Decimal(5, 2)
  hours_per_point       Decimal  @default(2) @db.Decimal(4, 1)
  default_session_hours Decimal  @default(1) @db.Decimal(4, 1)
  period_minutes        Int      @default(50)
  coefficient           Int      @default(1)
  created_at            DateTime @default(now())
  updated_at            DateTime @default(now()) @updatedAt

  academicYear AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)

  @@map("conduct_settings")
}

// Note de conduite d'un élève pour un trimestre.
// `computed_note` = calcul système ; `manual_note` = correction admin (prioritaire) ;
// `final_note` = manual_note ?? computed_note (matérialisée pour la lecture).
model conduct_grades {
  id               String    @id @default(uuid())
  academic_year_id String
  semester_id      String
  class_id         String
  student_id       String
  base_note        Decimal   @default(20) @db.Decimal(5, 2)
  absence_hours    Decimal   @default(0) @db.Decimal(6, 1)
  penalty          Decimal   @default(0) @db.Decimal(5, 2)
  computed_note    Decimal   @default(20) @db.Decimal(5, 2)
  manual_note      Decimal?  @db.Decimal(5, 2)
  final_note       Decimal   @default(20) @db.Decimal(5, 2)
  comment          String?
  is_validated     Boolean   @default(false)
  computed_at      DateTime?
  validated_at     DateTime?
  validated_by     String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  academicYear AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  semester     semesters    @relation(fields: [semester_id], references: [id], onDelete: Cascade)
  class        SchoolClass  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [student_id], references: [id], onDelete: Cascade)
  validatedBy  User?        @relation(fields: [validated_by], references: [id], onDelete: SetNull)

  @@unique([academic_year_id, semester_id, class_id, student_id], map: "conduct_grades_year_semester_class_student_key")
  @@index([academic_year_id])
  @@index([semester_id])
  @@index([class_id])
  @@index([student_id])
  @@map("conduct_grades")
}

// Correction manuelle des heures d'absence retenues pour une matière
// (justification a posteriori). Remplace le total calculé pour cette matière.
model conduct_absence_overrides {
  id               String   @id @default(uuid())
  academic_year_id String
  semester_id      String
  class_id         String
  student_id       String
  subject_id       String
  hours            Decimal  @default(0) @db.Decimal(5, 1)
  reason           String?
  // Justificatif (PDF/image) fourni par l'admin pour appuyer la correction d'heures.
  justificatif_url      String?
  justificatif_filename String?
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  academicYear AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  semester     semesters    @relation(fields: [semester_id], references: [id], onDelete: Cascade)
  class        SchoolClass  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [student_id], references: [id], onDelete: Cascade)
  subject      subjects     @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@unique([academic_year_id, semester_id, student_id, subject_id], map: "conduct_absence_overrides_year_semester_student_subject_key")
  @@index([class_id])
  @@index([student_id])
  @@map("conduct_absence_overrides")
}

/// Publication des bulletins d'une classe pour un trimestre.
///
/// Le bulletin reste calculé à la volée à partir des notes ; cette table ne
/// stocke pas le document mais l'acte administratif de génération. Elle porte
/// deux règles métier : tant qu'aucune ligne n'existe pour (classe, trimestre,
/// année), les espaces Parent et Élève ne voient pas le bulletin ; et
/// `generated_at` — et non la date du jour — est la date imprimée sur le PDF.
model bulletin_releases {
  id               String   @id @default(uuid())
  academic_year_id String
  semester_id      String
  class_id         String
  generated_at     DateTime @default(now())
  generated_by     String?
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  academicYear AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  semester     semesters    @relation(fields: [semester_id], references: [id], onDelete: Cascade)
  class        SchoolClass  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  generatedBy  User?        @relation("BulletinReleaseGenerator", fields: [generated_by], references: [id], onDelete: SetNull)

  @@unique([academic_year_id, semester_id, class_id], map: "bulletin_releases_year_semester_class_key")
  @@index([class_id])
  @@index([semester_id])
  @@map("bulletin_releases")
}

