generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AcademicYear {
  id        String   @id
  name      String   @unique @db.VarChar(9)
  startYear Int      @map("start_year")
  endYear   Int      @map("end_year")
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")

  budgets              budgets[]
  budget_lines         budget_lines[]
  schedules            schedules[]
  inscriptions         inscriptions[]
  student_payments     student_payments[]
  custom_payment_plans custom_payment_plans[]
  timetables           class_timetables[]
  teacher_assignments  teacher_class_assignments[]
  semesters            semesters[]
  grades               grades[]
  student_absences     student_absences[]
  class_main_teachers  class_main_teachers[]
  attendance_sessions  attendance_sessions[]
  evaluation_types     evaluation_types[]
  conduct_settings     conduct_settings?
  conduct_grades       conduct_grades[]
  conduct_overrides    conduct_absence_overrides[]
  bulletin_releases    bulletin_releases[]

  @@map("academic_years")
}

model attendance_summaries {
  id              String   @id
  student_id      String
  month           Int
  year            Int
  total_days      Int
  present_days    Int      @default(0)
  absent_days     Int      @default(0)
  late_days       Int      @default(0)
  excused_days    Int      @default(0)
  attendance_rate Decimal? @db.Decimal(5, 2)
  created_at      DateTime @default(now())
  student         Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([student_id, month, year])
}

model attendances {
  id                         String           @id
  student_id                 String
  class_id                   String
  date                       DateTime         @db.Date
  period                     TimePeriod
  status                     AttendanceStatus
  excuse                     String?
  is_justified               Boolean          @default(false)
  justification_document_url String?
  recorded_by                String?
  recorded_at                DateTime         @default(now())
  class                      SchoolClass      @relation(fields: [class_id], references: [id], onDelete: Cascade)
  recordedBy                 User?            @relation(fields: [recorded_by], references: [id], onDelete: SetNull)
  student                    Student          @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([student_id, date, period])
}

// Appel par séance de cours (matière) — remplace l'appel demi-journée pour
// l'enseignant. Une séance = un appel pour (année, classe, matière, enseignant)
// à une date + créneau (dérivé de class_timetables). session_number = « Séance N ».
model attendance_sessions {
  id               String   @id @default(uuid())
  academic_year_id String
  class_id         String
  subject_id       String
  teacher_id       String
  date             DateTime @db.Date
  start_time       String?  @db.VarChar(10)
  end_time         String?  @db.VarChar(10)
  timetable_id     String?
  session_number   Int      @default(1)
  notes            String?
  recorded_by      String?
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  academicYear AcademicYear         @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  class        SchoolClass          @relation(fields: [class_id], references: [id], onDelete: Cascade)
  subject      subjects             @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  teacher      teachers             @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  recordedBy   User?                @relation(fields: [recorded_by], references: [id], onDelete: SetNull)
  records      attendance_records[]

  @@unique([academic_year_id, class_id, subject_id, teacher_id, date, start_time])
  @@index([academic_year_id, class_id, subject_id])
  @@index([teacher_id])
  @@index([date])
  @@map("attendance_sessions")
}

model attendance_records {
  id           String           @id @default(uuid())
  session_id   String
  student_id   String
  status       AttendanceStatus
  excuse       String?
  is_justified Boolean          @default(false)
  created_at   DateTime         @default(now())

  session attendance_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)
  student Student             @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([session_id, student_id])
  @@index([student_id])
  @@map("attendance_records")
}

/// Rattrapage d'une séance qui n'a pas eu lieu (§9.6).
///
/// Une ligne = la décision de l'enseignant sur **une occurrence manquée**
/// précise, identifiée par (créneau, date d'origine) — d'où la contrainte
/// d'unicité. Deux décisions possibles :
///  - SCHEDULED : reprogrammée à `makeup_date` (+ horaires, qui peuvent différer
///    de ceux du créneau) ;
///  - DISMISSED : écartée (« pas de cours ce jour » : férié, vacances). Sert de
///    mémoire — sans elle, l'occurrence réapparaîtrait indéfiniment comme
///    manquée, faute de calendrier de fermeture dans le système.
///
/// Classe/matière/enseignant ne sont pas dupliqués : ils se dérivent du créneau,
/// qui reste la source de vérité (cf. attendance_sessions).
model attendance_makeup_sessions {
  id            String    @id @default(uuid())
  timetable_id  String
  original_date DateTime  @db.Date
  makeup_date   DateTime? @db.Date
  start_time    String?   @db.VarChar(10)
  end_time      String?   @db.VarChar(10)
  status        String    @db.VarChar(20)
  reason        String?
  created_by    String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now()) @updatedAt

  timetable class_timetables @relation(fields: [timetable_id], references: [id], onDelete: Cascade)
  creator   User?            @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@unique([timetable_id, original_date])
  @@index([makeup_date])
  @@map("attendance_makeup_sessions")
}

/// Demande de déplacement d'un cours à venir, soumise par l'enseignant et
/// arbitrée par l'administration.
///
/// Distincte de `attendance_makeup_sessions` : une demande n'occupe rien dans
/// l'agenda tant qu'elle est `PENDING` — le cours d'origine reste appelable
/// normalement. Ce n'est qu'à l'approbation (`APPROVED`) qu'une ligne
/// `attendance_makeup_sessions` (statut `MOVED`) est créée, à la date demandée
/// ou à celle choisie par l'administration si elle a préféré en proposer une
/// autre (`decided_*`, qui prévaut alors sur `requested_*`).
model attendance_move_requests {
  id                    String    @id @default(uuid())
  timetable_id          String
  original_date         DateTime  @db.Date
  requested_date        DateTime  @db.Date
  requested_start_time  String    @db.VarChar(10)
  requested_end_time    String    @db.VarChar(10)
  reason                String?
  status                String    @default("PENDING") @db.VarChar(20)
  decided_date          DateTime? @db.Date
  decided_start_time    String?   @db.VarChar(10)
  decided_end_time      String?   @db.VarChar(10)
  admin_note            String?
  created_by            String?
  decided_by            String?
  decided_at            DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @default(now()) @updatedAt

  timetable class_timetables @relation(fields: [timetable_id], references: [id], onDelete: Cascade)
  requester User?            @relation("MoveRequestRequester", fields: [created_by], references: [id], onDelete: SetNull)
  decider   User?            @relation("MoveRequestDecider", fields: [decided_by], references: [id], onDelete: SetNull)

  @@unique([timetable_id, original_date])
  @@index([status])
  @@map("attendance_move_requests")
}

model audit_logs {
  id            String   @id
  user_id       String?
  action        String   @db.VarChar(100)
  resource_type String   @db.VarChar(50)
  resource_id   String?
  old_values    Json?
  new_values    Json?
  ip_address    String?  @db.Inet
  user_agent    String?
  success       Boolean  @default(true)
  error_message String?
  created_at    DateTime @default(now())
  user          User?    @relation(fields: [user_id], references: [id])

  @@index([resource_type, resource_id])
  @@index([user_id, created_at(sort: Desc)])
}

model budgets {
  id               String          @id
  academic_year_id String
  category         ExpenseCategory
  planned_amount   Decimal         @db.Decimal(10, 2)
  spent_amount     Decimal         @default(0) @db.Decimal(10, 2)
  remaining_amount Decimal         @db.Decimal(10, 2)
  notes            String?
  created_at       DateTime        @default(now())
  academicYear     AcademicYear    @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)

  @@unique([academic_year_id, category])
}

model budget_lines {
  id               String                @id @default(uuid())
  academic_year_id String
  title            String                @db.VarChar(200)
  amount           Decimal               @db.Decimal(10, 2)
  type             BudgetType
  parent_id        String?
  created_at       DateTime              @default(now())
  academicYear     AcademicYear          @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  parent           budget_lines?         @relation("BudgetLineParent", fields: [parent_id], references: [id], onDelete: Cascade)
  children         budget_lines[]        @relation("BudgetLineParent")
  transactions     budget_transactions[]

  @@index([academic_year_id])
  @@index([parent_id])
  @@index([type])
  @@map("budget_lines")
}

model budget_transactions {
  id                    String       @id @default(uuid())
  budget_line_id        String
  amount                Decimal      @db.Decimal(10, 2)
  transaction_date      DateTime     @db.Date
  description           String?      @db.Text
  justificatif_url      String?      @db.VarChar(500)
  justificatif_filename String?      @db.VarChar(255)
  created_at            DateTime     @default(now())
  created_by            String?
  budgetLine            budget_lines @relation(fields: [budget_line_id], references: [id], onDelete: Cascade)
  creator               User?        @relation("BudgetTransactionCreator", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([budget_line_id])
  @@index([transaction_date])
  @@index([created_by])
  @@map("budget_transactions")
}

model class_subjects {
  id             String      @id
  class_id       String
  subject_id     String
  teacher_id     String?
  hours_per_week Int         @default(1)
  coefficient    Int         @default(1)
  class          SchoolClass @relation(fields: [class_id], references: [id], onDelete: Cascade)
  subjects       subjects    @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@unique([class_id, subject_id])
}

model SchoolClass {
  id        String   @id
  name      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  attendances          attendances[]
  classSubjects        class_subjects[]
  inscriptions         inscriptions[]
  schedules            schedules[]
  schoolFeeRates       school_fee_rates[]
  students             Student[]
  timetables           class_timetables[]
  teacher_assignments  teacher_class_assignments[]
  custom_payment_plans custom_payment_plans[]
  grades               grades[]
  student_absences     student_absences[]
  main_teachers        class_main_teachers[]
  attendance_sessions  attendance_sessions[]
  evaluation_types     evaluation_types[]
  conduct_grades       conduct_grades[]
  conduct_overrides    conduct_absence_overrides[]
  bulletin_releases    bulletin_releases[]

  @@map("classes")
}

model disciplinary_incidents {
  id          String           @id
  student_id  String
  date        DateTime         @db.Date
  time        DateTime?        @db.Time(6)
  location    String?          @db.VarChar(100)
  description String
  severity    IncidentSeverity
  reported_by String?
  witnesses   String?
  created_at  DateTime         @default(now())
  student     Student          @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model expenses {
  id                String          @id
  category          ExpenseCategory
  amount            Decimal         @db.Decimal(10, 2)
  date              DateTime        @db.Date
  description       String
  supplier_name     String?         @db.VarChar(200)
  invoice_number    String?         @db.VarChar(100)
  invoice_url       String?
  payment_method    PaymentMethod?
  payment_reference String?         @db.VarChar(100)
  status            ExpenseStatus   @default(DRAFT)
  approved_by       String?
  approved_at       DateTime?
  recorded_by       String?
  created_at        DateTime        @default(now())
  approvedBy        User?           @relation("expenses_approved_byTousers", fields: [approved_by], references: [id])
  recordedBy        User?           @relation("expenses_recorded_byTousers", fields: [recorded_by], references: [id])
}

model inscriptions {
  id                String       @id
  academic_year_id  String
  class_id          String
  student_id        String
  created_at        DateTime     @default(now())
  updated_at        DateTime     @default(now())
  academicYear      AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  class             SchoolClass  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  student           Student      @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([student_id, academic_year_id])
  @@index([academic_year_id])
  @@index([class_id])
  @@index([student_id])
}

model parents {
  id                       String            @id
  user_id                  String?
  first_name               String            @db.VarChar(100)
  last_name                String            @db.VarChar(100)
  relation                 ParentRelation
  phone                    String            @db.VarChar(20)
  email                    String?           @db.VarChar(255)
  address                  String?
  profession               String?           @db.VarChar(100)
  workplace                String?           @db.VarChar(100)
  avatar_url               String?
  is_primary_contact       Boolean           @default(false)
  is_financial_responsible Boolean           @default(false)
  generated_password       String?           @map("generated_password") @db.VarChar(255)
  odoo_partner_id          Int?
  created_at               DateTime          @default(now())
  updated_at               DateTime          @default(now())
  user                     User?             @relation(fields: [user_id], references: [id])
  student_parents          student_parents[]
}

model payment_types {
  id                               String                             @id @default(uuid())
  name                             String                             @unique @db.VarChar(100)
  created_at                       DateTime                           @default(now()) @map("created_at")
  school_fee_rate_details          school_fee_rate_details[]
  custom_payment_plan_installments custom_payment_plan_installments[]

  @@map("payment_types")
}

model RefreshToken {
  id        String   @id
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model schedule_exceptions {
  id                     String    @id
  schedule_id            String
  date                   DateTime  @db.Date
  replacement_teacher_id String?
  is_cancelled           Boolean   @default(false)
  reason                 String?
  created_by             String?
  created_at             DateTime  @default(now())
  creator                User?     @relation(fields: [created_by], references: [id])
  schedules              schedules @relation(fields: [schedule_id], references: [id], onDelete: Cascade)
}

model schedules {
  id                  String                @id
  class_id            String
  subject_id          String
  teacher_id          String
  day_of_week         Int
  start_time          DateTime              @db.Time(6)
  end_time            DateTime              @db.Time(6)
  room                String?               @db.VarChar(50)
  academic_year_id    String
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now())
  schedule_exceptions schedule_exceptions[]
  academicYear        AcademicYear          @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  class               SchoolClass           @relation(fields: [class_id], references: [id], onDelete: Cascade)
  subjects            subjects              @relation(fields: [subject_id], references: [id], onDelete: Cascade)
}

model school_fee_rate_details {
  id                 String             @id
  school_fee_rate_id String
  payment_type_id    String
  amount             Decimal            @db.Decimal(10, 2)
  created_at         DateTime           @default(now())
  updated_at         DateTime           @default(now())
  payment_types      payment_types      @relation(fields: [payment_type_id], references: [id], onDelete: Cascade)
  school_fee_rates   school_fee_rates   @relation(fields: [school_fee_rate_id], references: [id], onDelete: Cascade)
  student_payments   student_payments[]

  @@unique([school_fee_rate_id, payment_type_id])
}

model school_fee_rates {
  id                      String                    @id
  class_id                String
  total_amount            Decimal                   @default(0) @db.Decimal(10, 2)
  is_for_state_assigned   Boolean                   @default(false)
  created_at              DateTime                  @default(now())
  updated_at              DateTime                  @default(now())
  school_fee_rate_details school_fee_rate_details[]
  class                   SchoolClass               @relation(fields: [class_id], references: [id], onDelete: Cascade)

  @@unique([class_id, is_for_state_assigned])
  @@index([class_id])
  @@index([is_for_state_assigned])
}

model student_parents {
  id         String         @id
  student_id String
  parent_id  String
  relation   ParentRelation
  created_at DateTime       @default(now())
  parents    parents        @relation(fields: [parent_id], references: [id], onDelete: Cascade)
  student    Student        @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([student_id, parent_id])
}

model student_payments {
  id                        String                  @id
  student_id                String
  academic_year_id          String
  school_fee_rate_detail_id String
  amount                    Decimal                 @db.Decimal(10, 2)
  expected_amount           Decimal                 @db.Decimal(10, 2)
  payment_date              DateTime                @db.Date
  payment_method            PaymentMethod
  receipt_number            String?                 @db.VarChar(50)
  reference                 String?                 @db.VarChar(100)
  notes                     String?
  status                    PaymentStatus           @default(PENDING)
  recorded_by               String?
  created_at                DateTime                @default(now())
  updated_at                DateTime                @default(now())
  academicYear              AcademicYear            @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  recordedBy                User?                   @relation(fields: [recorded_by], references: [id])
  school_fee_rate_details   school_fee_rate_details @relation(fields: [school_fee_rate_detail_id], references: [id], onDelete: Cascade)
  student                   Student                 @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([academic_year_id])
  @@index([payment_date])
  @@index([school_fee_rate_detail_id])
  @@index([status])
  @@index([student_id, academic_year_id])
  @@index([student_id])
}

model Student {
  id            String  @id
  userId        String? @map("user_id")
  studentNumber String  @unique @map("student_number") @db.VarChar(20)

  // Personal information
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  dateOfBirth  DateTime @map("date_of_birth") @db.Date
  placeOfBirth String?  @map("place_of_birth") @db.VarChar(100)
  gender       String   @db.VarChar(10)
  nationality  String?  @db.VarChar(50)

  // Contact
  phone     String? @db.VarChar(20)
  email     String? @db.VarChar(255)
  address   String? @db.Text
  avatarUrl String? @map("avatar_url") @db.Text

  // Medical information
  bloodType    String? @map("blood_type") @db.VarChar(5)
  allergies    String? @db.Text
  medicalNotes String? @map("medical_notes") @db.Text

  // Academic information
  classId        String?       @map("class_id")
  enrollmentDate DateTime      @map("enrollment_date") @db.Date
  status         StudentStatus @default(ACTIVE)

  // Documents
  birthCertificateUrl     String? @map("birth_certificate_url") @db.Text
  vaccinationCardUrl      String? @map("vaccination_card_url") @db.Text
  previousSchoolReportUrl String? @map("previous_school_report_url") @db.Text

  // State assignment & attachments
  isStateAssigned Boolean  @default(false) @map("is_state_assigned")
  attachments     String[] @default([]) @map("attachments")

  // Compte de connexion : mot de passe généré affiché dans l'onglet « Compte ».
  generatedPassword String? @map("generated_password") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user                  User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  class                 SchoolClass?             @relation(fields: [classId], references: [id], onDelete: SetNull)
  attendances           attendances[]
  attendanceSummaries   attendance_summaries[]
  disciplinaryIncidents disciplinary_incidents[]
  studentPayments       student_payments[]
  studentParents        student_parents[]
  customPaymentPlans    custom_payment_plans[]
  inscriptions          inscriptions[]
  grades                grades[]
  student_absences      student_absences[]
  attendanceRecords     attendance_records[]
  conduct_grades        conduct_grades[]
  conduct_overrides     conduct_absence_overrides[]

  @@map("students")
}

model subjects {
  id                  String                      @id
  name                String                      @db.VarChar(100)
  code                String                      @unique @db.VarChar(20)
  coefficient         Int                         @default(1)
  description         String?
  created_at          DateTime                    @default(now())
  class_subjects      class_subjects[]
  schedules           schedules[]
  timetables          class_timetables[]
  teacher_assignments teacher_class_assignments[]
  grades              grades[]
  student_absences    student_absences[]
  teacher_subjects    teacher_subjects[]
  attendance_sessions attendance_sessions[]
  evaluation_types    evaluation_types[]
  conduct_overrides   conduct_absence_overrides[]
}

model User {
  id           String    @id
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole
  roleId       String?   @map("role_id")
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  isProtected  Boolean   @default(false) @map("is_protected")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  customRole                   Role?                          @relation(fields: [roleId], references: [id])
  refreshTokens               RefreshToken[]
  students                    Student[]
  parents                     parents[]
  expensesApproved            expenses[]                    @relation("expenses_approved_byTousers")
  expensesRecorded            expenses[]                    @relation("expenses_recorded_byTousers")
  scheduleExceptions          schedule_exceptions[]
  attendancesRecorded         attendances[]
  conductGradesValidated      conduct_grades[]
  auditLogs                   audit_logs[]
  studentPaymentsRecorded     student_payments[]
  customPaymentPlansCreated   custom_payment_plans[]        @relation("CustomPaymentPlanCreator")
  budgetTransactionsCreated   budget_transactions[]         @relation("BudgetTransactionCreator")
  teacher                     teachers?
  payrollsValidated           monthly_payrolls[]            @relation("PayrollValidator")
  payrollsCreated             monthly_payrolls[]            @relation("PayrollCreator")
  payrollPaymentsCreated      payroll_payments[]            @relation("PayrollPaymentCreator")
  advancePaymentsCreated      advance_payments[]            @relation("AdvancePaymentCreator")
  advancePaymentsApproved      advance_payments[]            @relation("AdvancePaymentApprover")
  payrollCorrectionsResponded payroll_correction_requests[] @relation("PayrollCorrectionResponder")
  absencesCreated              teacher_absences[]            @relation("AbsenceCreator")
  attendanceSessionsRecorded   attendance_sessions[]
  attendanceMakeupsCreated     attendance_makeup_sessions[]
  bulletinReleasesGenerated    bulletin_releases[]           @relation("BulletinReleaseGenerator")
  moveRequestsCreated          attendance_move_requests[]    @relation("MoveRequestRequester")
  moveRequestsDecided          attendance_move_requests[]    @relation("MoveRequestDecider")

  @@map("users")
}

