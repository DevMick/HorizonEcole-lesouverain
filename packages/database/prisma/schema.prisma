/// Rôle personnalisé du personnel, contrôlant uniquement les menus visibles
/// dans le sidebar (pas les autorisations API, qui restent basées sur UserRole).
model Role {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  isProtected Boolean  @default(false) @map("is_protected")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  menus RoleMenu[]
  users User[]

  @@map("roles")
}

model RoleMenu {
  id      String @id @default(uuid())
  roleId  String @map("role_id")
  menuKey String @map("menu_key") @db.VarChar(100)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuKey])
  @@map("role_menus")
}

model custom_payment_plans {
  id                               String                             @id @default(uuid())
  student_id                       String
  class_id                         String
  academic_year_id                 String
  name                             String                             @db.VarChar(200)
  description                      String?                            @db.Text
  total_amount                     Decimal                            @db.Decimal(10, 2)
  is_active                        Boolean                            @default(true)
  created_at                       DateTime                           @default(now())
  updated_at                       DateTime                           @default(now()) @updatedAt
  created_by                       String?
  academicYear                     AcademicYear                       @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  student                          Student                            @relation(fields: [student_id], references: [id], onDelete: Cascade)
  class                            SchoolClass                        @relation(fields: [class_id], references: [id], onDelete: Cascade)
  creator                          User?                              @relation("CustomPaymentPlanCreator", fields: [created_by], references: [id], onDelete: SetNull)
  custom_payment_plan_installments custom_payment_plan_installments[]

  @@unique([student_id, academic_year_id])
  @@index([student_id])
  @@index([class_id])
  @@index([academic_year_id])
  @@index([is_active])
  @@map("custom_payment_plans")
}

model custom_payment_plan_installments {
  id                     String               @id @default(uuid())
  custom_payment_plan_id String
  payment_type_id        String
  installment_number     Int
  due_date               DateTime             @db.Date
  amount                 Decimal              @db.Decimal(10, 2)
  is_paid                Boolean              @default(false)
  paid_at                DateTime?
  notes                  String?              @db.Text
  created_at             DateTime             @default(now())
  updated_at             DateTime             @default(now()) @updatedAt
  custom_payment_plans   custom_payment_plans @relation(fields: [custom_payment_plan_id], references: [id], onDelete: Cascade)
  payment_types          payment_types        @relation(fields: [payment_type_id], references: [id], onDelete: Cascade)

  @@index([custom_payment_plan_id])
  @@index([payment_type_id])
  @@index([due_date])
  @@index([is_paid])
  @@map("custom_payment_plan_installments")
}

model teachers {
  id                   String                      @id @default(uuid())
  first_name           String                      @db.VarChar(100)
  last_name            String                      @db.VarChar(100)
  email                String                      @unique @db.VarChar(255)
  phone                String                      @db.VarChar(20)
  contract_type        TeacherContractType
  hire_date            DateTime                    @db.Date
  end_date             DateTime?                   @db.Date // Pour CDD uniquement
  specialties          String                      @db.Text
  qualifications       String                      @db.Text
  attachments          String[]                    @default([])
  generated_password   String?                     @map("generated_password") @db.VarChar(255)
  odoo_partner_id      Int?
  user_id              String?                     @unique @map("user_id") @db.VarChar(255)
  created_at           DateTime                    @default(now())
  updated_at           DateTime                    @default(now()) @updatedAt
  timetables           class_timetables[]
  class_assignments    teacher_class_assignments[]
  grades               grades[]
  evaluation_types     evaluation_types[]
  student_absences     student_absences[]
  main_teacher_classes class_main_teachers[]
  user                 User?                       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  remuneration         teacher_remuneration?
  allowances           teacher_allowances[]
  monthly_payrolls     monthly_payrolls[]
  advance_payments     advance_payments[]
  hours                teacher_hours[]
  absences             teacher_absences[]
  subjects             teacher_subjects[]
  attendance_sessions  attendance_sessions[]
  eval_coefficients    teacher_evaluation_coefficients[]

  @@index([email])
  @@index([contract_type])
  @@index([user_id])
  @@map("teachers")
}

// Matières qu'un enseignant est habilité à enseigner (saisies sur sa fiche),
// distinct de teacher_class_assignments qui lie enseignant/classe/matière/année
// (dérivé de l'emploi du temps effectif).
model teacher_subjects {
  id         String   @id @default(uuid())
  teacher_id String
  subject_id String
  created_at DateTime @default(now())

  teacher teachers @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  subject subjects @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@unique([teacher_id, subject_id])
  @@index([teacher_id])
  @@index([subject_id])
  @@map("teacher_subjects")
}

model teacher_class_assignments {
  id               String   @id @default(uuid())
  teacher_id       String
  class_id         String
  subject_id       String
  academic_year_id String
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  teacher       teachers     @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  class         SchoolClass  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  subject       subjects     @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  academic_year AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)

  @@unique([teacher_id, class_id, subject_id, academic_year_id])
  @@index([teacher_id])
  @@index([class_id])
  @@index([subject_id])
  @@index([academic_year_id])
  @@map("teacher_class_assignments")
}

model class_main_teachers {
  id               String   @id @default(uuid())
  academic_year_id String
  teacher_id       String
  class_id         String
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  academicYear AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  teacher      teachers     @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  class        SchoolClass  @relation(fields: [class_id], references: [id], onDelete: Cascade)

  @@unique([teacher_id, academic_year_id]) // Un enseignant ne peut être professeur principal que d'une seule classe par année
  @@unique([class_id, academic_year_id]) // Une classe ne peut avoir qu'un seul professeur principal par année
  @@index([academic_year_id])
  @@index([teacher_id])
  @@index([class_id])
  @@map("class_main_teachers")
}

model classrooms {
  id         String             @id @default(uuid())
  name       String             @unique @db.VarChar(100)
  created_at DateTime           @default(now())
  updated_at DateTime           @default(now()) @updatedAt
  timetables class_timetables[]

  @@index([name])
  @@map("classrooms")
}

/// Créneaux horaires réutilisables (§ Emploi du temps) — liste gérée par
/// l'utilisateur (« + » dans le formulaire d'ajout de créneau), indépendante
/// des lignes class_timetables (qui stockent leurs propres start_time/end_time).
model horaires {
  id         String   @id @default(uuid())
  start_time String   @db.VarChar(10)
  end_time   String   @db.VarChar(10)
  // Type de créneau : COURS (par défaut), RECREATION (récréation) ou
  // PAUSE (pause / après-midi). Les créneaux non-COURS s'affichent en bande
  // pleine largeur dans la grille et le PDF, sans matière ni enseignant.
  type       String   @default("COURS") @db.VarChar(20)
  created_at DateTime @default(now())

  @@unique([start_time, end_time])
  @@map("horaires")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model class_timetables {
  id               String       @id @default(uuid())
  academic_year_id String
  class_id         String
  day_of_week      DayOfWeek
  start_time       String       @db.VarChar(10)
  end_time         String       @db.VarChar(10)
  subject_id       String
  teacher_id       String
  classroom_id     String
  created_at       DateTime     @default(now())
  updated_at       DateTime     @default(now()) @updatedAt
  academicYear     AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  class            SchoolClass  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  subject          subjects     @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  teacher          teachers     @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  classroom        classrooms   @relation(fields: [classroom_id], references: [id], onDelete: Cascade)
  makeups          attendance_makeup_sessions[]
  moveRequests     attendance_move_requests[]

  @@unique([academic_year_id, class_id, day_of_week, start_time])
  @@index([academic_year_id])
  @@index([class_id])
  @@index([day_of_week])
  @@map("class_timetables")
}

model semesters {
  id               String             @id @default(uuid())
  name             String             @db.VarChar(100)
  start_date       DateTime           @db.Date
  end_date         DateTime           @db.Date
  academic_year_id String
  /// Poids du trimestre dans la moyenne générale annuelle. Par convention les
  /// deux derniers trimestres comptent double (1er = 1, 2e et 3e = 2), d'où une
  /// MGA sur 5 coefficients : (T1 + 2×T2 + 2×T3) / 5.
  coefficient      Int                @default(1)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @default(now()) @updatedAt
  academicYear      AcademicYear                @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  grades            grades[]
  student_absences  student_absences[]
  conduct_grades    conduct_grades[]
  conduct_overrides conduct_absence_overrides[]
  bulletin_releases bulletin_releases[]

  @@index([academic_year_id])
  @@index([start_date])
  @@index([end_date])
  @@map("semesters")
}

model evaluation_types {
  id               String        @id @default(uuid())
  name             String        @db.VarChar(200)
  teacher_id       String
  academic_year_id String?
  class_id         String?
  subject_id       String?
  coefficient      Int?          @default(1)
  number           Int?
  max_note         Int           @default(20)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @default(now()) @updatedAt
  teacher          teachers      @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  academicYear     AcademicYear? @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  class            SchoolClass?  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  subject          subjects?     @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  grades           grades[]

  @@index([teacher_id])
  @@index([academic_year_id])
  @@index([class_id])
  @@index([subject_id])
  @@map("evaluation_types")
}

// Coefficients d'évaluation personnalisés créés par un enseignant (bouton « + »
// du champ Coefficient). Les deux coefficients par défaut (1 et 2) restent
// applicatifs et ne figurent PAS dans cette table : ils sont toujours proposés.
model teacher_evaluation_coefficients {
  id         String   @id @default(uuid())
  teacher_id String
  value      Int
  label      String?  @db.VarChar(60)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  teacher    teachers @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@unique([teacher_id, value])
  @@index([teacher_id])
  @@map("teacher_evaluation_coefficients")
}

model grades {
  id                 String           @id @default(uuid())
  academic_year_id   String
  teacher_id         String
  subject_id         String
  semester_id        String
  student_id         String
  class_id           String
  evaluation_type_id String
  note               Decimal          @db.Decimal(5, 2)
  max_note           Int              @default(20)
  created_at         DateTime         @default(now())
  updated_at         DateTime         @default(now()) @updatedAt
  academicYear       AcademicYear     @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  teacher            teachers         @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  subject            subjects         @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  semester           semesters        @relation(fields: [semester_id], references: [id], onDelete: Cascade)
