{
  "name": "api",
  "version": "1.0.0",
  "description": "API Backend pour le système de gestion scolaire",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "NODE_ENV=test jest --runInBand --detectOpenHandles",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "test:students": "tsx src/scripts/test-students.ts",
    "convert:inscriptions": "tsx src/scripts/convert-inscriptions-to-students.ts",
    "generate:evaluation-data": "tsx src/scripts/generate-evaluation-data.ts",
    "sync:odoo-parents": "tsx src/scripts/sync-parents-to-odoo.ts",
    "sync:odoo-teachers": "tsx src/scripts/sync-teachers-to-odoo.ts",
    "sync:odoo-classes": "tsx src/scripts/sync-classes-to-odoo.ts",
    "sync:odoo-academic-years": "tsx src/scripts/sync-academic-years-to-odoo.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@school/config": "workspace:*",
    "@school/database": "workspace:*",
    "@school/types": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/pdfkit": "^0.17.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "docxtemplater": "^3.67.4",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "html-pdf-node": "^1.0.8",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.11.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.17.2",
    "pizzip": "^3.2.0",
    "puppeteer": "^24.30.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/jest": "^29.5.11",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pizzip": "^3.1.2",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  }
}
