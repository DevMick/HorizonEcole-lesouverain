import { useState, useEffect } from 'react';
import {
  Button,
  Select,
  Space,
  message,
  Tag,
  Row,
  Col,
  Switch,
  Spin,
} from 'antd';
import { BookOpen, Link2, Save } from 'lucide-react';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { api } from '../lib/api';
import { PageHeader } from '../components/ui/page-header';
import { GlassCard } from '../components/ui/glass-card';
import { EmptyState } from '../components/ui/empty-state';

export default function SubjectAssignmentPage() {
  const [selectedClassId, setSelectedClassId] = useState<string | null>(null);
  const [selectedSubjects, setSelectedSubjects] = useState<string[]>([]);
  const queryClient = useQueryClient();

  // Fetch classes
  const { data: classesData } = useQuery({
    queryKey: ['assignment-classes'],
    queryFn: async () => {
      const response = await api.get('/subject-assignments/classes');
      return response.data.data;
    },
  });

  // Fetch subjects for selected class
  const { data: subjectsData, isLoading } = useQuery({
    queryKey: ['assignment-subjects', selectedClassId],
    queryFn: async () => {
      if (!selectedClassId) return [];
      const response = await api.get(`/subject-assignments/class/${selectedClassId}`);
      return response.data.data;
    },
    enabled: !!selectedClassId,
  });

  // Initialize selected subjects when data loads
  useEffect(() => {
    if (subjectsData) {
      const assignedIds = subjectsData
        .filter((s: any) => s.isAssigned)
        .map((s: any) => s.id);
      setSelectedSubjects(assignedIds);
    }
  }, [subjectsData]);

  // Save mutation
  const saveMutation = useMutation({
    mutationFn: async (data: { classId: string; subjectIds: string[] }) => {
      const response = await api.post(`/subject-assignments/class/${data.classId}`, {
        subjectIds: data.subjectIds,
      });
      return response.data;
    },
    onSuccess: (data) => {
      message.success(data.message || 'Affectations enregistrées avec succès !');
      queryClient.invalidateQueries({ queryKey: ['assignment-subjects', selectedClassId] });
      queryClient.invalidateQueries({ queryKey: ['assignment-classes'] });
    },
    onError: (error: any) => {
      message.error(error.response?.data?.error || 'Erreur lors de l\'enregistrement');
    },
  });

  const handleToggleSubject = (subjectId: string, checked: boolean) => {
    if (checked) {
      setSelectedSubjects(prev => [...prev, subjectId]);
    } else {
      setSelectedSubjects(prev => prev.filter(id => id !== subjectId));
    }
  };

  const handleSelectAll = () => {
    if (subjectsData) {
      setSelectedSubjects(subjectsData.map((s: any) => s.id));
    }
  };

  const handleDeselectAll = () => {
    setSelectedSubjects([]);
  };

  const handleSave = () => {
    if (!selectedClassId) {
      message.warning('Veuillez sélectionner une classe');
      return;
    }

    saveMutation.mutate({
      classId: selectedClassId,
      subjectIds: selectedSubjects,
    });
  };

  const selectedClass = classesData?.find((c: any) => c.id === selectedClassId);

  return (
    <div className="animate-fade-in mx-auto max-w-7xl space-y-8">
      <PageHeader
        title="Affectation des Matières"
        description="Affecter les matières enseignées dans chaque classe"
        action={
          selectedClassId ? (
            <Button
              type="primary"
              icon={<Save className="h-5 w-5" aria-hidden="true" />}
              onClick={handleSave}
              loading={saveMutation.isPending}
              size="large"
              className="flex items-center gap-2 rounded-xl bg-role-gradient border-0 shadow-md hover:shadow-lg transition-all hover:-translate-y-0.5"
            >
              Enregistrer
            </Button>
          ) : undefined
        }
      />

      <GlassCard variant="glass" styles={{ body: { padding: '32px' } }}>
        <div className="flex flex-col md:flex-row items-center gap-6">
          <div className="w-full md:w-1/2">
            <label className="mb-3 block text-sm font-semibold text-foreground/80 uppercase tracking-wider">
              Sélectionner une classe
            </label>
            <Select
              placeholder="Choisissez une classe..."
              size="large"
              style={{ width: '100%' }}
              className="modern-select"
              value={selectedClassId}
              onChange={(value) => {
                setSelectedClassId(value);
                setSelectedSubjects([]);
              }}
              options={classesData?.map((cls: any) => ({
                label: `${cls.name} (${cls._count?.classSubjects || 0} matière${cls._count?.classSubjects > 1 ? 's' : ''})`,
                value: cls.id,
              }))}
            />
          </div>
          {selectedClassId && selectedClass && (
            <div className="flex items-center gap-4 mt-6 md:mt-8">
              <div className="flex items-center gap-2 rounded-xl bg-role-primary/10 px-4 py-2 border border-role-primary/20">
                <span className="text-sm font-medium text-role-primary">Classe:</span>
                <span className="text-base font-bold text-foreground">{selectedClass.name}</span>
              </div>
              <div className="flex items-center gap-2 rounded-xl bg-purple-500/10 px-4 py-2 border border-purple-500/20">
                <span className="text-sm font-medium text-purple-600 dark:text-purple-400">Matières:</span>
                <span className="text-base font-bold text-foreground">
                  {selectedSubjects.length} / {subjectsData?.length || 0}
                </span>
              </div>
            </div>
          )}
        </div>
      </GlassCard>

      {selectedClassId && (
        <GlassCard variant="glass" styles={{ body: { padding: '32px' } }}>
          <div className="mb-6 flex justify-between items-center">
            <h3 className="text-lg font-bold text-foreground">Liste des matières</h3>
            <Space>
              <Button onClick={handleSelectAll} className="rounded-lg">
                Tout sélectionner
              </Button>
              <Button onClick={handleDeselectAll} className="rounded-lg">
                Tout désélectionner
              </Button>
            </Space>
          </div>
          <div className="mt-4">
            {isLoading ? (
              <div className="flex justify-center py-16">
                <Spin size="large" />
              </div>
            ) : subjectsData && subjectsData.length > 0 ? (
              <Row gutter={[24, 24]}>
                {subjectsData.map((subject: any) => {
                  const isSelected = selectedSubjects.includes(subject.id);
                  return (
                    <Col xs={24} sm={12} lg={12} xl={8} key={subject.id}>
                      <div 
                        onClick={() => handleToggleSubject(subject.id, !isSelected)}
                        className={`relative overflow-hidden rounded-2xl border-2 p-5 transition-all cursor-pointer duration-300 group ${
                          isSelected 
                            ? 'border-role-primary bg-role-primary/5 shadow-md shadow-role-primary/10' 
                            : 'border-border/50 bg-background/50 hover:border-role-primary/30 hover:shadow-sm'
                        }`}
                      >
                        {isSelected && (
                          <div className="absolute top-0 right-0 w-24 h-24 bg-role-gradient opacity-10 rounded-bl-full -z-10 transition-all duration-500" />
                        )}
                        
                        <div className="flex items-start justify-between gap-4 z-10 relative">
                          <div className="flex items-center gap-4">
                            <div className={`flex h-12 w-12 items-center justify-center rounded-xl transition-colors duration-300 ${
                              isSelected 
                                ? 'bg-role-primary text-white shadow-inner shadow-white/20' 
                                : 'bg-muted text-muted-foreground group-hover:text-role-primary group-hover:bg-role-primary/10'
                            }`}>
                               <BookOpen className="h-6 w-6" aria-hidden="true" />
                            </div>
                            <div>
                              <h4 className={`text-lg font-bold tracking-tight transition-colors duration-300 ${isSelected ? 'text-role-primary' : 'text-foreground'}`}>
                                {subject.name}
                              </h4>
                              {subject.code && <p className="text-sm text-muted-foreground font-medium mt-0.5">{subject.code}</p>}
                            </div>
                          </div>
                          
                          <div className="pt-2">
                            <Switch 
                              checked={isSelected} 
                              onChange={(checked, e) => {
                                e.stopPropagation();
                                handleToggleSubject(subject.id, checked);
                              }}
                            />
                          </div>
                        </div>
                      </div>
                    </Col>
                  );
                })}
              </Row>
            ) : (
              <div className="text-center py-10 text-muted-foreground">
                Aucune matière trouvée pour cette classe.
              </div>
            )}
          </div>
        </GlassCard>
      )}

      {!selectedClassId && (
        <EmptyState
          icon={Link2}
          title="Sélectionnez une classe"
          description="Choisissez une classe pour afficher et affecter les matières."
        />
      )}
    </div>
  );
}

